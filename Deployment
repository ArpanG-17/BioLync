### 8. `src/app/globals.css`

```css
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --background: #f5f1e8;
  --foreground: #1a1a1a;
}

html,
body {
  height: 100%;
}

body {
  background-color: var(--background);
  color: var(--foreground);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", "Noto Sans", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Exact visual match to the live prototype */
.signin {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1.25rem;
}

.signin-card {
  width: 100%;
  max-width: 420px;
  text-align: center;
}

.brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  margin-bottom: 2.5rem;
}

.brand.centered {
  justify-content: center;
}

.brand-logo {
  width: 28px;
  height: 28px;
  object-fit: contain;
}

.brand span {
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: #1a1a1a;
}

.eyebrow {
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #8a8a8a;
  margin-bottom: 1.25rem;
  font-weight: 500;
}

.signin h1 {
  font-family: Georgia, Cambria, "Times New Roman", Times, serif;
  font-size: 2.65rem;
  line-height: 1.15;
  font-weight: 400;
  color: #1a1a1a;
  margin-bottom: 1.1rem;
  letter-spacing: -0.01em;
}

.signin h1 em {
  font-style: italic;
  color: #4a7c59;
}

.signin-copy {
  font-size: 0.95rem;
  line-height: 1.55;
  color: #5c5c5c;
  margin-bottom: 2.25rem;
  max-width: 340px;
  margin-left: auto;
  margin-right: auto;
}

.signin label {
  display: block;
  text-align: left;
  font-size: 0.8rem;
  color: #6b6b6b;
  margin-bottom: 1.75rem;
}

.signin label input {
  display: block;
  width: 100%;
  margin-top: 0.4rem;
  padding: 0.55rem 0;
  font-size: 1rem;
  background: transparent;
  border: none;
  border-bottom: 1.5px solid #c8c4bc;
  color: #1a1a1a;
  outline: none;
  transition: border-color 0.2s ease;
}

.signin label input::placeholder {
  color: #b0aaa0;
}

.signin label input:focus {
  border-bottom-color: #4a7c59;
}

.primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.85rem 1.25rem;
  font-size: 0.95rem;
  font-weight: 500;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s ease, opacity 0.2s ease;
  background-color: #8a8a8a;
  color: #f5f1e8;
}

.primary-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.primary-button:not(:disabled):hover {
  background-color: #6f6f6f;
}

.primary-button.full {
  width: 100%;
}

.signin-note {
  display: block;
  margin-top: 1.75rem;
  font-size: 0.75rem;
  color: #9a9590;
  letter-spacing: 0.01em;
}

.primary-button:focus-visible {
  outline: 2px solid #4a7c59;
  outline-offset: 2px;
}

input:focus-visible {
  outline: none;
}
